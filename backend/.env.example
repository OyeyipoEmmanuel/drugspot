APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./drugspot.db
AUTH_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://drugspot.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
NAFDAC_API_BASE_URL=https://greenbook.nafdac.gov.ng
NAFDAC_API_TIMEOUT_SECONDS=12
OCR_SPACE_API_KEY=git p
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_TIMEOUT_SECONDS=25

# Admin bootstrap (optional - creates initial platform admin if none exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PHONE=

